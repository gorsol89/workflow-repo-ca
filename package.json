{
  "scripts": {
    "dev": "npx tailwindcss -i ./css/input.css -o ./css/style.css --watch",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:unit": "vitest run",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.1",
    "eslint": "^9.34.0",
    "globals": "^16.3.0",
    "husky": "^9.0.0",
    "jsdom": "^27.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.12",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.js": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.html": [
      "prettier --write"
    ]
  },
  "vitest": {
    "environment": "jsdom"
  }
}
